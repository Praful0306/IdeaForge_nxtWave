# NagarNetra Environment Variables Example

# Supabase (PostgreSQL + PostGIS + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq Keys (Primary AI Provider - Round Robin with 429 Cooling)
GROQ_API_KEY_1=gsk_your_groq_key_1
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_STT_MODEL=whisper-large-v3

# Google Gemini Keys (Backup AI Provider - Fallback on Groq 429/failure)
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash

# Officer Portal PIN (Default: 7789)
OFFICER_PIN=7789
